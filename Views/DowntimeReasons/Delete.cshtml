@model AISSmartFactory.Models.Master.DowntimeReason

@{
    ViewData["Title"] = "Deactivate Downtime Reason";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-danger shadow">

                <div class="card-header bg-danger text-white">

                    <h4>
                        Deactivate Downtime Reason
                    </h4>

                </div>

                <div class="card-body">

                    <div class="alert alert-warning">

                        This will deactivate the reason.
                        Existing records will not be deleted.

                    </div>

                    <dl class="row">

                        <dt class="col-sm-5">
                            Code
                        </dt>

                        <dd class="col-sm-7">
                            @Model.ReasonCode
                        </dd>

                        <dt class="col-sm-5">
                            Name
                        </dt>

                        <dd class="col-sm-7">
                            @Model.ReasonName
                        </dd>

                        <dt class="col-sm-5">
                            Category
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Category
                        </dd>

                    </dl>

                    <form asp-action="Delete">

                        <input type="hidden"
                               asp-for="Id" />

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-danger">
                            Deactivate
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
