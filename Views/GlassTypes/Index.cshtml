@model IEnumerable<AISSmartFactory.Models.Master.GlassType>

@{
    ViewData["Title"] = "Glass Type Master";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                Glass Type Master
            </h2>

            <p class="text-muted mb-0">
                Manage glass specifications used in CNC production
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Add Glass Type

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>
                                Glass Code
                            </th>

                            <th>
                                Glass Name
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Thickness
                            </th>

                            <th>
                                Width
                            </th>

                            <th>
                                Height
                            </th>

                            <th>
                                Color
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="9"
                                    class="text-center text-muted py-4">

                                    No glass types found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @item.GlassCode
                                        </strong>
                                    </td>

                                    <td>
                                        @item.GlassName
                                    </td>

                                    <td>
                                        @item.GlassCategory
                                    </td>

                                    <td>
                                        @item.Thickness
                                    </td>

                                    <td>
                                        @item.Width
                                    </td>

                                    <td>
                                        @item.Length
                                    </td>

                                    <td>
                                        @item.CoatingType
                                    </td>

                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            @if (item.IsActive)
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-danger">
                                                    Deactivate
                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>