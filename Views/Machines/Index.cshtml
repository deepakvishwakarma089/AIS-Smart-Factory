@model IEnumerable<AISSmartFactory.Models.Master.Machine>

@{
    ViewData["Title"] = "Machine Master";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Machine Master</h2>
            <p class="text-muted mb-0">
                Manage CNC machines and production lines
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Machine
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Machine Code</th>
                            <th>Machine Name</th>
                            <th>Type</th>
                            <th>Controller</th>
                            <th>Line</th>
                            <th>IP Address</th>
                            <th>Status</th>
                            <th>Active</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.MachineCode
                                    </strong>
                                </td>

                                <td>
                                    @item.MachineName
                                </td>

                                <td>
                                    @item.MachineType
                                </td>

                                <td>
                                    @item.Controller
                                </td>

                                <td>
                                    @item.LineName
                                </td>

                                <td>
                                    @item.IPAddress
                                    @if (item.Port.HasValue)
                                    {
                                        <small class="text-muted">
                                            :@item.Port
                                        </small>
                                    }
                                </td>

                                <td>

                                    @if (item.IsOnline)
                                    {
                                        <span class="badge bg-success">
                                            Online
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Offline
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Deactivate
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>