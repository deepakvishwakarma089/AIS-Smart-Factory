@model AISSmartFactory.Models.Master.Machine

@{
    ViewData["Title"] = "Deactivate Machine";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-danger">

                <div class="card-header bg-danger text-white">

                    <h4 class="mb-0">
                        Deactivate Machine
                    </h4>

                </div>

                <div class="card-body">

                    <div class="alert alert-warning">

                        <strong>Warning:</strong>

                        This will deactivate the machine.
                        Historical production and CNC data will
                        not be deleted.

                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">
                            Machine Code
                        </dt>

                        <dd class="col-sm-8">
                            @Model.MachineCode
                        </dd>

                        <dt class="col-sm-4">
                            Machine Name
                        </dt>

                        <dd class="col-sm-8">
                            @Model.MachineName
                        </dd>

                        <dt class="col-sm-4">
                            Controller
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Controller
                        </dd>

                        <dt class="col-sm-4">
                            Production Line
                        </dt>

                        <dd class="col-sm-8">
                            @Model.LineName
                        </dd>

                    </dl>

                    <form asp-action="Delete">

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Deactivate Machine
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>