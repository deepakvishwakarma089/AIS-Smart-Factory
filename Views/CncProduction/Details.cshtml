@model AISSmartFactory.Models.Production.CncProductionEntry

@{
    ViewData["Title"] = "Production Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between mb-4">

        <div>

            <h2>
                Production Details
            </h2>

            <p class="text-muted">
                @Model.ProductionNumber
            </p>

        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

    <div class="row">

        <!-- BASIC -->

        <div class="col-lg-6 mb-4">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    Production Information
                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-6">
                            Production Number
                        </dt>

                        <dd class="col-sm-6">
                            @Model.ProductionNumber
                        </dd>

                        <dt class="col-sm-6">
                            Date
                        </dt>

                        <dd class="col-sm-6">
                            @Model.ProductionDate
                        </dd>

                        <dt class="col-sm-6">
                            Machine ID
                        </dt>

                        <dd class="col-sm-6">
                            @Model.MachineId
                        </dd>

                        <dt class="col-sm-6">
                            Operator ID
                        </dt>

                        <dd class="col-sm-6">
                            @Model.OperatorId
                        </dd>

                        <dt class="col-sm-6">
                            Glass Type ID
                        </dt>

                        <dd class="col-sm-6">
                            @Model.GlassTypeId
                        </dd>

                        <dt class="col-sm-6">
                            CNC Program ID
                        </dt>

                        <dd class="col-sm-6">
                            @Model.CncProgramId
                        </dd>

                        <dt class="col-sm-6">
                            Tool ID
                        </dt>

                        <dd class="col-sm-6">
                            @Model.ToolId
                        </dd>

                    </dl>

                </div>

            </div>

        </div>

        <!-- QUANTITY -->

        <div class="col-lg-6 mb-4">

            <div class="card shadow">

                <div class="card-header bg-success text-white">
                    Production Quantity
                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-6">
                            Planned
                        </dt>

                        <dd class="col-sm-6">
                            @Model.PlannedQuantity
                        </dd>

                        <dt class="col-sm-6">
                            Produced
                        </dt>

                        <dd class="col-sm-6">
                            @Model.ProducedQuantity
                        </dd>

                        <dt class="col-sm-6">
                            Good
                        </dt>

                        <dd class="col-sm-6 text-success fw-bold">
                            @Model.GoodQuantity
                        </dd>

                        <dt class="col-sm-6">
                            Rejected
                        </dt>

                        <dd class="col-sm-6 text-danger fw-bold">
                            @Model.RejectedQuantity
                        </dd>

                        <dt class="col-sm-6">
                            Quality Approved
                        </dt>

                        <dd class="col-sm-6">
                            @(Model.QualityApproved ? "Yes" : "No")
                        </dd>

                        <dt class="col-sm-6">
                            Status
                        </dt>

                        <dd class="col-sm-6">
                            @(Model.IsCompleted
                                ? "Completed"
                                : "In Progress")
                        </dd>

                    </dl>

                </div>

            </div>

        </div>

        <!-- PARAMETERS -->

        <div class="col-lg-12 mb-4">

            <div class="card shadow">

                <div class="card-header bg-dark text-white">
                    CNC Process Parameters
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-3">
                            <strong>Cycle Time</strong>
                            <br />
                            @Model.CycleTimeSeconds sec
                        </div>

                        <div class="col-md-3">
                            <strong>Spindle RPM</strong>
                            <br />
                            @Model.SpindleRpm
                        </div>

                        <div class="col-md-3">
                            <strong>Feed Rate</strong>
                            <br />
                            @Model.FeedRate
                        </div>

                        <div class="col-md-3">
                            <strong>Cutting Depth</strong>
                            <br />
                            @Model.CuttingDepth
                        </div>

                        <div class="col-md-3 mt-3">
                            <strong>Coolant Pressure</strong>
                            <br />
                            @Model.CoolantPressure
                        </div>

                        <div class="col-md-3 mt-3">
                            <strong>Air Pressure</strong>
                            <br />
                            @Model.AirPressure
                        </div>

                        <div class="col-md-3 mt-3">
                            <strong>Machine Load</strong>
                            <br />
                            @Model.MachineLoadPercent %
                        </div>

                        <div class="col-md-3 mt-3">
                            <strong>Energy</strong>
                            <br />
                            @Model.EnergyKwh kWh
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
