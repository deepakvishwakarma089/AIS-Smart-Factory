@model AISSmartFactory.Models.Master.CncProgram

@{
    ViewData["Title"] = "Deactivate CNC Program";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-danger">

                <div class="card-header bg-danger text-white">

                    <h4 class="mb-0">
                        Deactivate CNC Program
                    </h4>

                </div>

                <div class="card-body">

                    <div class="alert alert-warning">

                        <strong>Warning:</strong>

                        This will deactivate the CNC program.
                        Existing production records will not
                        be deleted.

                    </div>


                    <dl class="row">

                        <dt class="col-sm-5">
                            Program Code
                        </dt>

                        <dd class="col-sm-7">
                            @Model.ProgramCode
                        </dd>


                        <dt class="col-sm-5">
                            Program Name
                        </dt>

                        <dd class="col-sm-7">
                            @Model.ProgramName
                        </dd>


                        <dt class="col-sm-5">
                            Machine
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Machine?.MachineCode
                        </dd>


                        <dt class="col-sm-5">
                            Glass Type
                        </dt>

                        <dd class="col-sm-7">
                            @Model.GlassType?.GlassCode
                        </dd>


                        <dt class="col-sm-5">
                            Operation
                        </dt>

                        <dd class="col-sm-7">
                            @Model.OperationType
                        </dd>

                    </dl>


                    <form asp-action="Delete">

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Deactivate Program
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>