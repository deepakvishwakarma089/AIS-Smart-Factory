@model AISSmartFactory.Models.Master.CncProgram

@{
    ViewData["Title"] = "Add CNC Program";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">

                    <h4 class="mb-0">
                        Add CNC Program
                    </h4>

                </div>

                <div class="card-body">

                    <form asp-action="Create">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="row">

                            <!-- Program Code -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="ProgramCode"
                                       class="form-label">
                                    Program Code
                                </label>

                                <input asp-for="ProgramCode"
                                       class="form-control"
                                       placeholder="CNC-PGM-001" />

                                <span asp-validation-for="ProgramCode"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Program Name -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="ProgramName"
                                       class="form-label">
                                    Program Name
                                </label>

                                <input asp-for="ProgramName"
                                       class="form-control"
                                       placeholder="Glass Edge Drilling" />

                                <span asp-validation-for="ProgramName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Program Number -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="ProgramNumber"
                                       class="form-label">
                                    CNC Program Number
                                </label>

                                <input asp-for="ProgramNumber"
                                       class="form-control"
                                       placeholder="O1001" />

                            </div>


                            <!-- Revision -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="Revision"
                                       class="form-label">
                                    Revision
                                </label>

                                <input asp-for="Revision"
                                       class="form-control"
                                       placeholder="Rev-01" />

                            </div>


                            <!-- Machine -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="MachineId"
                                       class="form-label">
                                    CNC Machine
                                </label>

                                <select asp-for="MachineId"
                                        asp-items="ViewBag.Machines"
                                        class="form-select">

                                    <option value="">
                                        -- Select Machine --
                                    </option>

                                </select>

                                <span asp-validation-for="MachineId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Glass Type -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="GlassTypeId"
                                       class="form-label">
                                    Glass Type
                                </label>

                                <select asp-for="GlassTypeId"
                                        asp-items="ViewBag.GlassTypes"
                                        class="form-select">

                                    <option value="">
                                        -- Select Glass Type --
                                    </option>

                                </select>

                                <span asp-validation-for="GlassTypeId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Operation -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="OperationType"
                                       class="form-label">
                                    Operation Type
                                </label>

                                <select asp-for="OperationType"
                                        class="form-select">

                                    <option value="">
                                        -- Select Operation --
                                    </option>

                                    <option value="Drilling">
                                        Drilling
                                    </option>

                                    <option value="Cutting">
                                        Cutting
                                    </option>

                                    <option value="Grinding">
                                        Grinding
                                    </option>

                                    <option value="Edge Processing">
                                        Edge Processing
                                    </option>

                                    <option value="Polishing">
                                        Polishing
                                    </option>

                                    <option value="Slotting">
                                        Slotting
                                    </option>

                                    <option value="Milling">
                                        Milling
                                    </option>

                                    <option value="Other">
                                        Other
                                    </option>

                                </select>

                            </div>


                            <!-- Cycle Time -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="TargetCycleTime"
                                       class="form-label">
                                    Target Cycle Time
                                </label>

                                <div class="input-group">

                                    <input asp-for="TargetCycleTime"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           placeholder="120" />

                                    <span class="input-group-text">
                                        sec
                                    </span>

                                </div>

                            </div>


                            <!-- Description -->

                            <div class="col-12 mb-3">

                                <label asp-for="Description"
                                       class="form-label">
                                    Description
                                </label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="3"
                                          placeholder="CNC program description">
                                </textarea>

                            </div>


                            <!-- Active -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Status
                                </label>

                                <div class="form-check form-switch">

                                    <input asp-for="IsActive"
                                           class="form-check-input"
                                           type="checkbox"
                                           checked />

                                    <label asp-for="IsActive"
                                           class="form-check-label">
                                        Active Program
                                    </label>

                                </div>

                            </div>

                        </div>


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Save CNC Program
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}