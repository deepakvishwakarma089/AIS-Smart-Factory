@model IEnumerable<AISSmartFactory.Models.Master.Tool>

@{
    ViewData["Title"] = "Tool Master";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Tool Master</h2>

            <p class="text-muted mb-0">
                Manage CNC tools and tool life
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Tool
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Tool Code</th>
                            <th>Tool Name</th>
                            <th>Type</th>
                            <th>Tool Number</th>
                            <th>Diameter</th>
                            <th>Max RPM</th>
                            <th>Expected Life</th>
                            <th>Current Life</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="10"
                                    class="text-center text-muted py-4">

                                    No tools found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @item.ToolCode
                                        </strong>
                                    </td>

                                    <td>
                                        @item.ToolName
                                    </td>

                                    <td>
                                        @item.ToolType
                                    </td>

                                    <td>
                                        @item.ToolNumber
                                    </td>

                                    <td>
                                        @item.Diameter
                                    </td>

                                    <td>
                                        @item.MaximumRpm
                                    </td>

                                    <td>
                                        @item.ExpectedLife
                                        @item.LifeUnit
                                    </td>

                                    <td>
                                        @item.CurrentLife
                                        @item.LifeUnit
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            @if (item.IsActive)
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-danger">
                                                    Deactivate
                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>