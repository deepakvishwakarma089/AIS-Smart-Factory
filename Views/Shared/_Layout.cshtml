```cshtml
@using Microsoft.AspNetCore.Mvc.Rendering

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - AIS Smart Factory
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

        /* =====================================================
                   GLOBAL
                   ===================================================== */

        body {
            margin: 0;
            background-color: #f4f6f9;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #243b53;
        }


        /* =====================================================
                   TOP NAVBAR
                   ===================================================== */

        .ais-navbar {
            height: 64px;
            background-color: #0b1f33;
            box-shadow: 0 2px 8px rgba(0,0,0,.15);
            z-index: 1100;
        }

        .ais-brand {
            color: white !important;
            font-size: 21px;
            font-weight: 700;
            text-decoration: none;
            line-height: 1.1;
        }

            .ais-brand small {
                display: block;
                color: #9fb3c8;
                font-size: 10px;
                font-weight: 400;
                margin-top: 3px;
            }

        .ais-clock {
            color: #d9e3ec;
            font-size: 13px;
            white-space: nowrap;
        }


        /* =====================================================
                   SIDEBAR
                   ===================================================== */

        .ais-sidebar {
            position: fixed;
            top: 64px;
            left: 0;
            bottom: 0;
            width: 250px;
            background-color: #102a43;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1000;
            padding-bottom: 30px;
            scrollbar-width: thin;
            scrollbar-color: #355b7d #102a43;
        }

            .ais-sidebar::-webkit-scrollbar {
                width: 6px;
            }

            .ais-sidebar::-webkit-scrollbar-track {
                background: #102a43;
            }

            .ais-sidebar::-webkit-scrollbar-thumb {
                background: #355b7d;
                border-radius: 10px;
            }


        /* =====================================================
                   MENU SECTION
                   ===================================================== */

        .ais-menu-title {
            padding: 20px 18px 8px;
            color: #8fa9c1;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }


        /* =====================================================
                   MENU LINKS
                   ===================================================== */

        .ais-menu-link {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 2px 10px;
            padding: 11px 14px;
            border-radius: 6px;
            color: #d7e2ec;
            text-decoration: none;
            font-size: 14px;
            transition: all .15s ease;
        }

            .ais-menu-link:hover {
                background-color: #1c405f;
                color: white;
                transform: translateX(2px);
            }

            .ais-menu-link.active {
                background-color: #1677c8;
                color: white;
                font-weight: 600;
                box-shadow: 0 2px 5px rgba(0,0,0,.15);
            }

        .ais-menu-icon {
            width: 24px;
            min-width: 24px;
            text-align: center;
            font-size: 16px;
        }


        /* =====================================================
                   DISABLED MENU
                   ===================================================== */

        .ais-menu-disabled {
            opacity: .45;
            cursor: not-allowed;
        }

            .ais-menu-disabled:hover {
                background-color: transparent;
                color: #d7e2ec;
                transform: none;
            }


        /* =====================================================
                   MAIN CONTENT
                   ===================================================== */

        .ais-main {
            margin-left: 250px;
            padding-top: 64px;
            min-height: 100vh;
        }

        .ais-content {
            padding: 25px;
            min-height: calc(100vh - 125px);
        }


        /* =====================================================
                   PAGE HEADER
                   ===================================================== */

        .ais-page-header {
            margin-bottom: 20px;
            background: white;
            padding: 18px 22px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,.06);
        }

        .ais-page-title {
            margin: 0;
            color: #102a43;
            font-size: 24px;
            font-weight: 700;
        }

        .ais-page-subtitle {
            margin-top: 4px;
            color: #7b8794;
            font-size: 13px;
        }


        /* =====================================================
                   CARDS
                   ===================================================== */

        .ais-card {
            background: white;
            border: 1px solid #e1e7ed;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,.06);
        }

        .ais-card-header {
            padding: 15px 18px;
            border-bottom: 1px solid #e1e7ed;
            color: #102a43;
            font-weight: 700;
        }

        .ais-card-body {
            padding: 18px;
        }


        /* =====================================================
                   KPI CARDS
                   ===================================================== */

        .ais-kpi {
            background: white;
            padding: 18px;
            border-radius: 8px;
            border-left: 4px solid #1677c8;
            box-shadow: 0 2px 6px rgba(0,0,0,.06);
        }

        .ais-kpi-title {
            color: #7b8794;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .ais-kpi-value {
            margin-top: 5px;
            color: #102a43;
            font-size: 28px;
            font-weight: 700;
        }

        .ais-kpi-green {
            border-left-color: #22a06b;
        }

        .ais-kpi-orange {
            border-left-color: #f59e0b;
        }

        .ais-kpi-red {
            border-left-color: #dc3545;
        }


        /* =====================================================
                   TABLE
                   ===================================================== */

        .ais-table {
            background: white;
            border-radius: 8px;
            overflow: hidden;
        }

            .ais-table thead {
                background-color: #102a43;
                color: white;
            }

            .ais-table th {
                padding: 12px;
                font-size: 13px;
                font-weight: 600;
                white-space: nowrap;
            }

            .ais-table td {
                padding: 11px 12px;
                font-size: 13px;
                vertical-align: middle;
            }


        /* =====================================================
                   STATUS
                   ===================================================== */

        .ais-status {
            display: inline-block;
            padding: 4px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .ais-status-running {
            background-color: #d1fae5;
            color: #047857;
        }

        .ais-status-idle {
            background-color: #fef3c7;
            color: #92400e;
        }

        .ais-status-stopped {
            background-color: #fee2e2;
            color: #b91c1c;
        }

        .ais-status-maintenance {
            background-color: #dbeafe;
            color: #1d4ed8;
        }


        /* =====================================================
                   BUTTONS
                   ===================================================== */

        .ais-btn-primary {
            background-color: #1677c8;
            border-color: #1677c8;
            color: white;
        }

            .ais-btn-primary:hover {
                background-color: #125fa3;
                border-color: #125fa3;
                color: white;
            }


        /* =====================================================
                   FOOTER
                   ===================================================== */

        .ais-footer {
            padding: 15px 25px;
            background-color: white;
            border-top: 1px solid #e1e7ed;
            color: #7b8794;
            font-size: 12px;
        }


        /* =====================================================
                   MOBILE MENU BUTTON
                   ===================================================== */

        .mobile-menu-button {
            display: none;
        }


        /* =====================================================
                   MOBILE OVERLAY
                   ===================================================== */

        .ais-sidebar-overlay {
            display: none;
            position: fixed;
            top: 64px;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,.35);
            z-index: 999;
        }


        /* =====================================================
                   RESPONSIVE
                   ===================================================== */

        @@media (max-width: 991px) {

            .ais-sidebar {
                transform: translateX(-100%);
                transition: transform .2s ease;
            }

                .ais-sidebar.show {
                    transform: translateX(0);
                }

            .ais-main {
                margin-left: 0;
            }

            .mobile-menu-button {
                display: block;
            }

            .ais-content {
                padding: 15px;
            }

            .ais-clock {
                display: none;
            }

            .ais-sidebar-overlay.show {
                display: block;
            }
        }


        @@media (max-width: 575px) {

            .ais-brand {
                font-size: 17px;
            }

                .ais-brand small {
                    font-size: 9px;
                }

            .ais-content {
                padding: 10px;
            }

            .ais-footer {
                padding: 12px 15px;
            }

                .ais-footer .d-flex {
                    flex-direction: column;
                    gap: 5px;
                }
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>

    <!-- =====================================================
         TOP NAVBAR
         ===================================================== -->

    <nav class="navbar ais-navbar fixed-top">

        <div class="container-fluid">

            <div class="d-flex align-items-center">

                <button type="button"
                        class="btn btn-outline-light mobile-menu-button me-3"
                        onclick="toggleSidebar()"
                        aria-label="Toggle navigation">

                    ☰

                </button>


                <a class="ais-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    AIS Smart Factory

                    <small>
                        CNC Production Monitoring System
                    </small>

                </a>

            </div>


            <div class="d-flex align-items-center">

                <span id="aisClock"
                      class="ais-clock me-4">
                </span>


                <div class="dropdown">

                    <button class="btn btn-outline-light btn-sm dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                        Admin

                    </button>


                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>

                            <a class="dropdown-item"
                               asp-controller="Home"
                               asp-action="Index">

                                📊 Dashboard

                            </a>

                        </li>

                        <li>
                            <hr class="dropdown-divider" />
                        </li>

                        <li>

                            <span class="dropdown-item-text text-muted">
                                AIS Smart Factory
                            </span>

                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </nav>


    <!-- =====================================================
         MOBILE OVERLAY
         ===================================================== -->

    <div id="aisSidebarOverlay"
         class="ais-sidebar-overlay"
         onclick="toggleSidebar()">
    </div>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <aside id="aisSidebar"
           class="ais-sidebar">


        <!-- =================================================
             MAIN
             ================================================= -->

        <div class="ais-menu-title">
            Main
        </div>


        <a class="ais-menu-link"
           asp-controller="Home"
           asp-action="Index">

            <span class="ais-menu-icon">📊</span>

            Dashboard

        </a>


        <!-- =================================================
             PRODUCTION
             ================================================= -->

        <div class="ais-menu-title">
            Production
        </div>


        <a class="ais-menu-link"
           asp-controller="CncProduction"
           asp-action="Index">

            <span class="ais-menu-icon">⚙️</span>

            CNC Production

        </a>


        <a class="ais-menu-link"
           asp-controller="DowntimeReasons"
           asp-action="Index">

            <span class="ais-menu-icon">⏱️</span>

            Machine Downtime

        </a>


        <!-- =================================================
             MASTER DATA
             ================================================= -->

        <div class="ais-menu-title">
            Master Data
        </div>


        <a class="ais-menu-link"
           asp-controller="Machines"
           asp-action="Index">

            <span class="ais-menu-icon">🏭</span>

            Machines

        </a>


        <a class="ais-menu-link"
           asp-controller="Operators"
           asp-action="Index">

            <span class="ais-menu-icon">👷</span>

            Operators

        </a>


        <a class="ais-menu-link"
           asp-controller="GlassTypes"
           asp-action="Index">

            <span class="ais-menu-icon">🪟</span>

            Glass Types

        </a>


        <a class="ais-menu-link"
           asp-controller="CncPrograms"
           asp-action="Index">

            <span class="ais-menu-icon">💻</span>

            CNC Programs

        </a>


        <a class="ais-menu-link"
           asp-controller="Tools"
           asp-action="Index">

            <span class="ais-menu-icon">🔧</span>

            Tools

        </a>


        <a class="ais-menu-link"
           asp-controller="DowntimeReasons"
           asp-action="Index">

            <span class="ais-menu-icon">⏸️</span>

            Downtime Reasons

        </a>


        <!-- =================================================
             QUALITY
             ================================================= -->

        <div class="ais-menu-title">
            Quality
        </div>



        <a class="ais-menu-link"
           asp-controller="QualityInspections"
           asp-action="Index">
            <span class="ais-menu-icon">✅</span>
            Quality Inspection
        </a>


        <a class="ais-menu-link"
           asp-controller="DefectTypes"
           asp-action="Index">
            <span class="ais-menu-icon">📋</span>
            Defect Master
        </a>


        <!-- =================================================
             TOOLING
             ================================================= -->

        <div class="ais-menu-title">
            Tooling
        </div>

<a class="ais-menu-link"
   asp-controller="ToolUsages"
   asp-action="Index">
    <span class="ais-menu-icon">🔧</span>
    Tool Usages
    </a>

        <!-- =================================================
             MAINTENANCE
             ================================================= -->

        <div class="ais-menu-title">
            Maintenance
        </div>


        <a class="ais-menu-link"
           asp-controller="MaintenanceRecords"
           asp-action="Index">

            <span class="ais-menu-icon">🛠️</span>

            Maintenance Records

        </a>


        <!-- =================================================
             REPORTS
             ================================================= -->

        <div class="ais-menu-title">
            Reports
        </div>


        <a class="ais-menu-link ais-menu-disabled"
           href="javascript:void(0)"
           title="Production Report will be added next">

            <span class="ais-menu-icon">📈</span>

            Production Report

        </a>


        <a class="ais-menu-link ais-menu-disabled"
           href="javascript:void(0)"
           title="OEE Report will be added next">

            <span class="ais-menu-icon">📊</span>

            OEE Report

        </a>


        <a class="ais-menu-link ais-menu-disabled"
           href="javascript:void(0)"
           title="Export module will be added later">

            <span class="ais-menu-icon">📥</span>

            Export Data

        </a>


        <!-- =================================================
             SYSTEM
             ================================================= -->

        <div class="ais-menu-title">
            System
        </div>


        <a class="ais-menu-link ais-menu-disabled"
           href="javascript:void(0)"
           title="User management will be added later">

            <span class="ais-menu-icon">👤</span>

            Users

        </a>


        <a class="ais-menu-link ais-menu-disabled"
           href="javascript:void(0)"
           title="Role management will be added later">

            <span class="ais-menu-icon">🔐</span>

            Roles & Permissions

        </a>


        <a class="ais-menu-link ais-menu-disabled"
           href="javascript:void(0)"
           title="Audit log will be added later">

            <span class="ais-menu-icon">📝</span>

            Audit Log

        </a>

    </aside>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main class="ais-main">

        <div class="ais-content">

            @RenderBody()

        </div>


        <!-- =================================================
             FOOTER
             ================================================= -->

        <footer class="ais-footer">

            <div class="d-flex justify-content-between">

                <span>
                    © @DateTime.Now.Year AIS Smart Factory
                </span>

                <span>
                    CNC Production Monitoring System
                </span>

            </div>

        </footer>

    </main>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <script>

        // =====================================================
        // SIDEBAR
        // =====================================================

        function toggleSidebar() {

            const sidebar =
                document.getElementById("aisSidebar");

            const overlay =
                document.getElementById("aisSidebarOverlay");

            if (!sidebar)
                return;

            sidebar.classList.toggle("show");

            if (overlay) {
                overlay.classList.toggle("show");
            }
        }


        // =====================================================
        // CLOCK
        // =====================================================

        function updateClock() {

            const clock =
                document.getElementById("aisClock");

            if (!clock)
                return;

            const now = new Date();

            clock.innerText =
                now.toLocaleString(
                    "en-IN",
                    {
                        day: "2-digit",
                        month: "short",
                        year: "numeric",
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit",
                        hour12: false
                    }
                );
        }


        updateClock();

        setInterval(
            updateClock,
            1000
        );


        // =====================================================
        // ACTIVE SIDEBAR MENU
        // =====================================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const currentPath =
                    window.location.pathname
                        .toLowerCase();

                const links =
                    document.querySelectorAll(
                        ".ais-menu-link"
                    );

                links.forEach(function (link) {

                    const href =
                        link.getAttribute("href");

                    if (!href ||
                        href === "#" ||
                        href.startsWith("javascript:")) {
                        return;
                    }

                    let linkPath = href;

                    try {

                        linkPath =
                            new URL(
                                href,
                                window.location.origin
                            ).pathname.toLowerCase();

                    }
                    catch {
                        return;
                    }

                    if (
                        linkPath !== "/" &&
                        currentPath.startsWith(linkPath)
                    ) {

                        link.classList.add("active");
                    }

                });

            }
        );


        // =====================================================
        // CLOSE MOBILE SIDEBAR AFTER NAVIGATION
        // =====================================================

        document.querySelectorAll(
            ".ais-menu-link:not(.ais-menu-disabled)"
        ).forEach(function (link) {

            link.addEventListener(
                "click",
                function () {

                    if (window.innerWidth <= 991) {

                        const sidebar =
                            document.getElementById(
                                "aisSidebar"
                            );

                        const overlay =
                            document.getElementById(
                                "aisSidebarOverlay"
                            );

                        if (sidebar) {
                            sidebar.classList.remove("show");
                        }

                        if (overlay) {
                            overlay.classList.remove("show");
                        }
                    }
                }
            );

        });

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
        )

</body>

</html>
```
