```cshtml
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - AIS Smart Factory
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

        body {
            margin: 0;
            background-color: #f4f6f9;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        /* ===========================
           TOP NAVBAR
           =========================== */

        .ais-navbar {
            height: 64px;
            background-color: #0b1f33;
            box-shadow: 0 2px 8px rgba(0,0,0,.15);
            z-index: 1100;
        }

        .ais-brand {
            color: white !important;
            font-size: 21px;
            font-weight: 700;
            text-decoration: none;
        }

        .ais-brand small {
            display: block;
            color: #9fb3c8;
            font-size: 10px;
            font-weight: 400;
        }

        .ais-clock {
            color: #d9e3ec;
            font-size: 13px;
        }

        /* ===========================
           SIDEBAR
           =========================== */

        .ais-sidebar {
            position: fixed;
            top: 64px;
            left: 0;
            bottom: 0;

            width: 250px;

            background-color: #102a43;

            overflow-y: auto;

            z-index: 1000;
        }

        .ais-menu-title {
            padding: 20px 18px 8px;

            color: #8fa9c1;

            font-size: 11px;
            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: 1px;
        }

        .ais-menu-link {
            display: flex;

            align-items: center;

            gap: 10px;

            margin: 2px 10px;

            padding: 11px 14px;

            border-radius: 6px;

            color: #d7e2ec;

            text-decoration: none;

            font-size: 14px;
        }

        .ais-menu-link:hover {
            background-color: #1c405f;

            color: white;
        }

        .ais-menu-icon {
            width: 24px;

            text-align: center;

            font-size: 16px;
        }

        /* ===========================
           MAIN CONTENT
           =========================== */

        .ais-main {
            margin-left: 250px;

            padding-top: 64px;

            min-height: 100vh;
        }

        .ais-content {
            padding: 25px;
        }

        /* ===========================
           PAGE HEADER
           =========================== */

        .ais-page-header {
            margin-bottom: 20px;

            background: white;

            padding: 18px 22px;

            border-radius: 8px;

            box-shadow: 0 2px 6px rgba(0,0,0,.06);
        }

        .ais-page-title {
            margin: 0;

            color: #102a43;

            font-size: 24px;

            font-weight: 700;
        }

        .ais-page-subtitle {
            margin-top: 4px;

            color: #7b8794;

            font-size: 13px;
        }

        /* ===========================
           CARDS
           =========================== */

        .ais-card {
            background: white;

            border: 1px solid #e1e7ed;

            border-radius: 8px;

            box-shadow: 0 2px 6px rgba(0,0,0,.06);
        }

        .ais-card-header {
            padding: 15px 18px;

            border-bottom: 1px solid #e1e7ed;

            color: #102a43;

            font-weight: 700;
        }

        .ais-card-body {
            padding: 18px;
        }

        /* ===========================
           KPI CARDS
           =========================== */

        .ais-kpi {
            background: white;

            padding: 18px;

            border-radius: 8px;

            border-left: 4px solid #1677c8;

            box-shadow: 0 2px 6px rgba(0,0,0,.06);
        }

        .ais-kpi-title {
            color: #7b8794;

            font-size: 12px;

            font-weight: 600;

            text-transform: uppercase;
        }

        .ais-kpi-value {
            margin-top: 5px;

            color: #102a43;

            font-size: 28px;

            font-weight: 700;
        }

        .ais-kpi-green {
            border-left-color: #22a06b;
        }

        .ais-kpi-orange {
            border-left-color: #f59e0b;
        }

        .ais-kpi-red {
            border-left-color: #dc3545;
        }

        /* ===========================
           TABLE
           =========================== */

        .ais-table {
            background: white;

            border-radius: 8px;

            overflow: hidden;
        }

        .ais-table thead {
            background-color: #102a43;

            color: white;
        }

        .ais-table th {
            padding: 12px;

            font-size: 13px;

            font-weight: 600;
        }

        .ais-table td {
            padding: 11px 12px;

            font-size: 13px;

            vertical-align: middle;
        }

        /* ===========================
           STATUS
           =========================== */

        .ais-status {
            display: inline-block;

            padding: 4px 9px;

            border-radius: 20px;

            font-size: 11px;

            font-weight: 600;
        }

        .ais-status-running {
            background-color: #d1fae5;

            color: #047857;
        }

        .ais-status-idle {
            background-color: #fef3c7;

            color: #92400e;
        }

        .ais-status-stopped {
            background-color: #fee2e2;

            color: #b91c1c;
        }

        .ais-status-maintenance {
            background-color: #dbeafe;

            color: #1d4ed8;
        }

        /* ===========================
           FOOTER
           =========================== */

        .ais-footer {
            padding: 15px 25px;

            background-color: white;

            border-top: 1px solid #e1e7ed;

            color: #7b8794;

            font-size: 12px;
        }

        /* ===========================
           MOBILE
           =========================== */

        .mobile-menu-button {
            display: none;
        }

        @@media (max-width: 991px) {

            .ais-sidebar {
                transform: translateX(-100%);

                transition: transform .2s ease;
            }

            .ais-sidebar.show {
                transform: translateX(0);
            }

            .ais-main {
                margin-left: 0;
            }

            .mobile-menu-button {
                display: block;
            }

            .ais-content {
                padding: 15px;
            }

            .ais-clock {
                display: none;
            }
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>


    <!-- ======================================
         TOP NAVBAR
         ====================================== -->

    <nav class="navbar ais-navbar fixed-top">

        <div class="container-fluid">

            <div class="d-flex align-items-center">

                <button type="button"
                        class="btn btn-outline-light mobile-menu-button me-3"
                        onclick="toggleSidebar()">

                    ☰

                </button>


                <a class="ais-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    AIS Smart Factory

                    <small>
                        CNC Production Monitoring System
                    </small>

                </a>

            </div>


            <div class="d-flex align-items-center">

                <span id="aisClock"
                      class="ais-clock me-4">
                </span>


                <div class="dropdown">

                    <button class="btn btn-outline-light btn-sm dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown">

                        Admin

                    </button>


                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>

                            <a class="dropdown-item"
                               asp-controller="Home"
                               asp-action="Index">

                                Dashboard

                            </a>

                        </li>


                        <li>
                            <hr class="dropdown-divider" />
                        </li>


                        <li>

                            <a class="dropdown-item"
                               href="#">

                                Logout

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </nav>


    <!-- ======================================
         SIDEBAR
         ====================================== -->

    <aside id="aisSidebar"
           class="ais-sidebar">


        <!-- MAIN -->

        <div class="ais-menu-title">
            Main
        </div>


        <a class="ais-menu-link"
           asp-controller="Home"
           asp-action="Index">

            <span class="ais-menu-icon">
                📊
            </span>

            Dashboard

        </a>


        <!-- PRODUCTION -->

        <div class="ais-menu-title">
            Production
        </div>


        <a class="ais-menu-link"
           asp-controller="CncProduction"
           asp-action="Index">

            <span class="ais-menu-icon">
                ⚙️
            </span>

            CNC Production

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                ⏱️
            </span>

            Downtime

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                ❌
            </span>

            Rejections

        </a>


        <!-- MASTER DATA -->

        <div class="ais-menu-title">
            Master Data
        </div>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                🏭
            </span>

            Machines

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                👷
            </span>

            Operators

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                🪟
            </span>

            Glass Types

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                💻
            </span>

            CNC Programs

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                🔧
            </span>

            Tools

        </a>


        <a class="ais-menu-link"
           asp-controller="DowntimeReasons"
           asp-action="Index">

            <span class="ais-menu-icon">
                ⏸️
            </span>

            Downtime Reasons

        </a>


        <!-- QUALITY -->

        <div class="ais-menu-title">
            Quality
        </div>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                ✅
            </span>

            Quality Inspection

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                📋
            </span>

            Defect Master

        </a>


        <!-- REPORTS -->

        <div class="ais-menu-title">
            Reports
        </div>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                📈
            </span>

            Production Report

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                📊
            </span>

            OEE Report

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                📥
            </span>

            Export Data

        </a>


        <!-- SYSTEM -->

        <div class="ais-menu-title">
            System
        </div>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                👤
            </span>

            Users

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                🔐
            </span>

            Roles & Permissions

        </a>


        <a class="ais-menu-link"
           href="#">

            <span class="ais-menu-icon">
                📝
            </span>

            Audit Log

        </a>

    </aside>


    <!-- ======================================
         MAIN CONTENT
         ====================================== -->

    <main class="ais-main">

        <div class="ais-content">

            @RenderBody()

        </div>


        <!-- FOOTER -->

        <footer class="ais-footer">

            <div class="d-flex justify-content-between">

                <span>
                    © @DateTime.Now.Year AIS Smart Factory
                </span>

                <span>
                    CNC Production Monitoring System
                </span>

            </div>

        </footer>

    </main>


    <!-- ======================================
         JAVASCRIPT
         ====================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <script>

        function toggleSidebar() {

            const sidebar =
                document.getElementById("aisSidebar");

            sidebar.classList.toggle("show");

        }


        function updateClock() {

            const clock =
                document.getElementById("aisClock");

            if (!clock)
                return;


            const now = new Date();


            clock.innerText =
                now.toLocaleString(
                    "en-IN",
                    {
                        day: "2-digit",
                        month: "short",
                        year: "numeric",
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit"
                    }
                );

        }


        updateClock();

        setInterval(
            updateClock,
            1000
        );

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html

